<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ole.panel</string>
  <!-- Ingen --host/--port her. Kommandolinja overstyrer vite.config.mjs, og da
       fantes verten to steder med hvert sitt svar: konfigurasjonen sa «::», mens
       denne sa «0.0.0.0» og vant. Serveren tok dermed bare IPv4, mens Mac-en
       annonserer .local-navnet med IPv6 i tillegg — som iPad-en velger først.
       Konfigurasjonen eier verten og porten nå, og testen vokter den. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>run</string>
    <string>dev</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ole-froiland/Desktop/Prosjekter/Work/ipad-control-center</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/ole-froiland/Library/Logs/Panel/panel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ole-froiland/Library/Logs/Panel/panel-error.log</string>
</dict>
</plist>
